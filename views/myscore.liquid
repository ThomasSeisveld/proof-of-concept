{% include 'partials/head.liquid' %}
<main>
    <section class="handicap-section">
    <header class="handicap-header">
       <h3>WHS HANDICAP</h3>
    </header>

    <article>
        <span class="handicap-value">
            {{ golfer.handicap | round: 1}}
        </span>

        <span class="handicap-change">
            {{ golfer.improvement | round: 1}}
        </span>
    </article>

    <p class="handicap-meta">
        Was <strong>{{ golfer.previous_handicap | round: 1}}</strong>
        op {{ golfer.previous_date | date: "%d %b %y" }} ·
        low <strong>{{ golfer.low | round: 1}}</strong>
    </p>
</section>

<section class="log-section">
  <article class="log-header">
    <span class="log-title">LOG</span>
    <span class="log-subtitle">Recente rondes</span>
  </article>
</section>

<section class="rounds-section">
    <header class="rounds-header">
        <article>
            <h3>Recente rondes</h3>
            <span>{{ recentRounds.size }} rondes</span>
        </article>

        <button popovertarget="add-score" class="add-round">
            + Ronde
        </button>
    </header>
     
    <ul class="rounds-list">
      {% if recentRounds.size > 0 %}
        {% for round in recentRounds %}
          <li class="round-item" data-score-id="{{ round.id }}">
            <article class="round-info">
              <p class="date">{{ round.date }}</p>
              <p class="course">
                {% if round.course %}
                  {{ round.course }}
                {% elsif round.course_name %}
                  {{ round.course_name }}
                {% else %}
                  Onbekend
                {% endif %}
              </p>
            </article>

            <section class="round-actions">
              {% if round.badge == "QUAL" %}
                <span class="badge">{{ round.badge }}</span>
              {% else %}
                  <span class="badge badge-negative">NOT</span>
              {% endif %}
              {% if round.hcp %}
              <span class="hcp">
                {% if round.hcp %}
                  {{ round.hcp }}
                {% else %}
                  -
                {% endif %}
              </span>
              {% endif %}
              <span>
               <form method="post" action="/score-verwijderen">
                        <input type="hidden" name="score_id" value="{{ round.id }}">
                        <button class="primary-button delete"><img src="assets/trash.svg" alt="verwijderen" width="20" height="20"></button>
              </form>
              </span>
            </section>
          </li>
        {% endfor %}
      {% else %}
        <li class="no-rounds">Geen recente rondes</li>
      {% endif %}
    </ul>
</section>

<section class="log-section">
  <article class="log-header">
    <span class="log-title">LOG</span>
    <span class="log-subtitle">Ranking lijst</span>
  </article>
</section>

<section class="ranking-section">
  <article class="ranking-header">
    <h3>Ranking lijst</h3>
    <span>{{ rankings.size }} Golfers</span>
    <nav class="tabs">
      <button class="active" type="button">{{ rankingCategory }}</button>
      <button type="button">All time</button>
    </nav>
  </article>

  <label class="month-label">{{ rankingMonthLabel }}</label>

  <ul class="ranking-list">
    {% for ranking in rankings %}
      <li class="{% if ranking.isMe %} active{% endif %}">
        <span class="rank">{{ forloop.index }}</span>
        <span class="avatar{% if ranking.isMe %} avatar-blue{% endif %}">{{ ranking.initials }}</span>
        <span class="content">
          <span class="name">{{ ranking.name }}</span>
          <span class="meta">Since {{ ranking.since }}</span>
        </span>
        <span class="score{% if ranking.value < 0 %} negative{% else %} positive{% endif %}">{{ ranking.value }}</span>
      </li>
    {% endfor %}
  </ul>
</section>
</main>
<form method="POST" action="/score-toevoegen" popover id="add-score">
            <input type="hidden" name="golfer_id" value="{{ golfer.id }}">
            <label>
                Datum:
                <input type="date" name="date" max="{{ 'today' | date: '%Y-%m-%d' }}" value="{{ 'today' | date: '%Y-%m-%d' }}">
            </label>
            <label>
                Baan:
                <input type="text" name="course">
            </label>
            <label>
                Score
                <input type="number" name="score">
            </label>
            <label>
                <input type="checkbox" checked name="type" value="QUAL">
                Telt mee voor handicap
            </label>
            <button class="primary-button">versturen</button>
      </form>

<article id="notification" class="notification">
  <span id="notification-message"></span>
</article>

{% include 'partials/footer.liquid' %}

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const notification = document.getElementById('notification');
  const notificationMessage = document.getElementById('notification-message');
  
  if (urlParams.get('deleted') === 'true') {
    notificationMessage.textContent = 'Ronde succesvol verwijderd!';
    notification.classList.add('show');
  } else if (urlParams.get('added') === 'true') {
    notificationMessage.textContent = 'Ronde succesvol toegevoegd!';
    notification.classList.add('show');
  }
  
  if (notification.classList.contains('show')) {
    setTimeout(() => {
      notification.classList.remove('show');
    }, 3000);
  }
</script>